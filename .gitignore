# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template with no secrets in it is meant to be committed.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source files (2 GB of videos/stills) — not part of the deployed web app
/WORK/

# Uploaded media now lives in Supabase Storage, not here. public/uploads/ is
# kept locally as the pre-migration copy but is no longer served or deployed —
# tracking ~187 MB of video made every clone and deploy slow.
/public/uploads/

# data/artworks.json is still committed: the app no longer reads it (Supabase
# does), but it's the input to scripts/migrate-to-supabase.mjs and a record of
# what the site held before the move. It's a few KB, so it costs nothing.

# .env.local stays out via the .env* rule above.
