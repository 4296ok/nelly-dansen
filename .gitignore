# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source files (2 GB of videos/stills) — not part of the deployed web app
/WORK/

# NOTE: data/artworks.json and public/uploads/* ARE committed for now so the
# preview deploy shows the current work. They move to Supabase for the real
# launch (Vercel's filesystem is read-only, so uploads there won't persist).
# .env.local stays out via the .env* rule above.
