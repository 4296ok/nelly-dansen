# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — real values never get committed.
#
# On Vercel, set these same three under:
#   Project → Settings → Environment Variables
# The site will not start without them.

# Password for the /admin area. Pick something long.
ADMIN_PASSWORD=

# Supabase project URL — no trailing path.
# Found under: Project Settings → API (the "Project URL" field).
# Correct:   https://xxxxxxxxxxxx.supabase.co
# Wrong:     https://xxxxxxxxxxxx.supabase.co/rest/v1/
SUPABASE_URL=

# Supabase service_role key (the secret one, NOT the public `anon` key).
# Found under: Project Settings → API Keys → service_role → Reveal.
# It bypasses all row-level security, so it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: live Instagram posts via behold.so. Leave blank to use the
# placeholder grid. See lib/instagram.ts.
BEHOLD_FEED_ID=
